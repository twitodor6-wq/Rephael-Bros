{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafael-brothers.invalid/schemas/transition-experiment.v1.schema.json",
  "title": "M469 isolated transition experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageId",
    "world",
    "spawn",
    "exit",
    "assets",
    "objects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "stageId": {
      "$ref": "#/$defs/id"
    },
    "world": {
      "$ref": "#/$defs/rect"
    },
    "spawn": {
      "$ref": "#/$defs/point"
    },
    "exit": {
      "$ref": "#/$defs/point"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/rect"
        }
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prefab",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prefab": {
            "$ref": "#/$defs/id"
          },
          "asset": {
            "$ref": "#/$defs/id"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
